# Root .env: read automatically by Docker Compose (docker-compose.yml).
# Copy to .env and adjust if needed:  cp .env.example .env
# All values are optional; the defaults below match docker-compose.yml.

# Local Postgres credentials (development only, never reuse in production).
POSTGRES_USER=summit
POSTGRES_PASSWORD=summit
POSTGRES_DB=summit

# Port on YOUR machine that forwards to Postgres in the container.
# 5434 avoids clashing with other Postgres instances on 5432/5433.
POSTGRES_PORT=5434
