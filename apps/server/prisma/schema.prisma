// Summit's database schema. Prisma turns this into SQL migrations (tables,
// columns, indexes) and into a fully typed TypeScript client.
//
// Naming: models and fields use camelCase in TypeScript (`passwordHash`),
// while tables and columns use snake_case in Postgres (`password_hash`), via
// @map / @@map. Each side follows its own convention.

generator client {
  // The new TypeScript-native client (Prisma 7+). It's generated into our
  // source tree and talks to Postgres through the `pg` driver adapter.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (read from DATABASE_URL).
}

/// A person with an account.
model User {
  /// Random UUID created by Postgres.
  id           String         @id @default(uuid()) @db.Uuid
  /// Stored trimmed and lowercased (the API schema normalizes it), so this
  /// unique index really means "one account per email address".
  email        String         @unique
  /// bcrypt hash; the password itself is never stored.
  passwordHash String         @map("password_hash")
  displayName  String         @map("display_name")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     FocusSession[]

  @@map("users")
}

/// A climbable peak, seeded from PEAKS in packages/shared (the source of
/// truth). Kept in the database so SQL queries can join on it (Phase 4 stats).
model Peak {
  /// Stable slug like "mt-fuji" (never renamed: progress refers to it).
  id           String @id
  name         String
  heightMeters Int    @map("height_meters")
  region       String
  /// Unlock order, starting at 1.
  order        Int    @unique

  @@map("peaks")
}

/// Session lifecycle: PLANNED → RUNNING → COMPLETED | ABANDONED.
enum SessionStatus {
  PLANNED
  RUNNING
  COMPLETED
  ABANDONED

  @@map("session_status")
}

/// One focus session. Breaks aren't stored.
model FocusSession {
  /// Generated by the client (a UUID), so the timer can start instantly and
  /// a retried request can't create a duplicate. No @default on purpose.
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  /// Deleting a user deletes their sessions too.
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedMinutes Int           @map("planned_minutes")
  /// Set by the SERVER's clock, never taken from the client.
  startedAt      DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(3)
  status         SessionStatus
  tag            String?
  /// Calculated by the server from status and plannedMinutes.
  metersGained   Int           @default(0) @map("meters_gained")
  /// Set for rope team sessions (Phase 3 adds the Room table and a foreign key).
  roomId         String?       @map("room_id") @db.Uuid
  /// True for history imported from a guest's browser (it couldn't be checked live).
  imported       Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  /// History is read newest-first per user, page by page. This index lets
  /// Postgres jump straight to "this user's sessions older than X".
  @@index([userId, startedAt(sort: Desc), id])
  @@map("focus_sessions")
}
