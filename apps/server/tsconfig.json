// TypeScript config for apps/server (Node + Express).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Load Node's built-in type definitions (process, http, Buffer...).
    // Listing them explicitly also stops TypeScript from auto-loading every
    // @types package it finds in node_modules.
    "types": ["node"]
  },
  // Source, co-located tests, the Prisma config, and the seed script.
  "include": ["src", "prisma", "prisma.config.ts", "vitest.config.ts"]
}
