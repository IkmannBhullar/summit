# Server environment variables. Copy to apps/server/.env:
#   cp apps/server/.env.example apps/server/.env
# The real .env is git-ignored; never commit secrets.

# Port the Express server listens on. Hosting platforms (Render) set this for you.
PORT=4000

# Postgres connection string, used by Prisma from Phase 2.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Matches the defaults in the root .env.example / docker-compose.yml.
DATABASE_URL=postgresql://summit:summit@localhost:5434/summit
