# Server environment variables. Copy to apps/server/.env:
#   cp apps/server/.env.example apps/server/.env
# The real .env is git-ignored; never commit secrets.

# development | test | production
NODE_ENV=development

# Port the Express server listens on. Hosting platforms (Render) set this for you.
PORT=4000

# Postgres connection string, used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Matches the defaults in the root .env.example / docker-compose.yml.
DATABASE_URL=postgresql://summit:summit@localhost:5434/summit

# Secret used to sign login tokens (JWTs). At least 32 characters, random,
# and different in every environment. Generate one with:
#   openssl rand -base64 48
# The server refuses to start without a long enough secret.
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48

# Where the web app is served from (scheme://host:port). Live connections
# (WebSockets) from any other website are refused. In production, set this
# to the deployed web app's address.
WEB_ORIGIN=http://localhost:5173

# How many proxies in front of the server add X-Forwarded-For, so Express can
# find each visitor's real IP (the login rate limit needs it). Leave it unset
# locally (0) and on a plain Render service (1). Behind Vercel's rewrite AND
# Render, it's 2 (render.yaml sets that).
# TRUST_PROXY_HOPS=
