# Web environment variables. Copy to apps/web/.env:
#   cp apps/web/.env.example apps/web/.env
#
# WARNING: only variables starting with VITE_ are exposed to the browser, and
# anything exposed to the browser is PUBLIC (anyone can read it in DevTools).
# Never put secrets here.

# Base URL of the Summit API. Leave empty to call the app's own origin: in
# development the Vite dev server forwards /api/... to http://localhost:4000,
# and in production Vercel forwards it to the API on Render (see vercel.json).
# Only set it if the API is reached directly at another address.
VITE_API_URL=

# Socket.io transports for live rope team rooms: "polling", "websocket", or
# "polling,websocket". Empty uses Socket.io's default (start with polling,
# upgrade to WebSocket). Production sets "polling": Vercel's rewrite forwards
# plain HTTP requests but not WebSocket connections.
VITE_REALTIME_TRANSPORTS=
