# EditorConfig: tells every editor (VS Code, JetBrains, Vim...) the same basic
# formatting rules, so files look identical no matter who edits them.
# https://editorconfig.org
root = true

# Rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# In Markdown, two trailing spaces mean a line break, so keep them.
[*.md]
trim_trailing_whitespace = false
